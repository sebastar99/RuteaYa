@model RuteaYa.Web.Models.PrevisualizacionRecorridoViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Previsualización de recorrido";
    ViewData["ActivePage"] = "Oportunidades";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
<link rel="stylesheet" href="~/css/recorridos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/direcciones-here.css" asp-append-version="true" />
<div class="page-heading">
    <div><h1>Previsualización del viaje #@Model.ViajeId</h1><p>@Model.Origen → @Model.Destino</p></div>
    <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index" asp-route-viajeId="@Model.ViajeId">Volver a oportunidades</a>
</div>
<div class="panel-card">
    <p>Confirmá cada ubicación y su punto de navegación. Incluso un único candidato requiere selección explícita.</p>
    <p>La selección dura diez minutos en este servidor. No se guardan coordenadas en el viaje ni se evalúa o acepta un envío.</p>
    <p>Escribí directamente en origen, paradas o destino para buscar sugerencias.</p>
    <a asp-controller="Recorridos" asp-action="Index" asp-route-viajeId="@Model.ViajeId">Renovar previsualización</a>
</div>
@if (Model.Error != null)
{
    <div class="panel-card" role="alert">@Model.Error</div>
}
@if (Model.UsaAutocompletado && Model.Ruta == null)
{
    <form asp-controller="Recorridos" asp-action="ConfirmarDirecciones" asp-route-viajeId="@Model.ViajeId" method="post" data-recorrido-autocompletado>
        <input type="hidden" name="Sesion" value="@Model.Sesion" />
        <p>Elegí y confirmá cada ubicación. Los cambios se usan solo en esta previsualización; el viaje conserva sus direcciones publicadas.</p>
        @for (var i = 0; i < Model.Ubicaciones.Count; i++)
        {
            <div class="panel-card">
                <partial name="_CampoDireccionHere" model="@(new RuteaYa.Web.Models.CampoDireccionViewModel {
                    IdHtml = $"direccion-{i}", Etiqueta = Model.Ubicaciones[i].Etiqueta,
                    TextoInicial = Model.Ubicaciones[i].Direccion, NombreToken = $"Confirmaciones[{i}]",
                    UrlSugerencias = Url.Action("Sugerencias", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion, ubicacion = i })!,
                    UrlResolver = Url.Action("ResolverDireccion", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion, ubicacion = i })!,
                    UrlConfirmar = Url.Action("ConfirmarDireccion", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion, ubicacion = i })!
                })" />
            </div>
        }
        <button class="panel-button" type="button" data-calcular-direcciones disabled>Calcular recorrido con ubicaciones confirmadas</button>
        <p role="status" aria-live="polite" data-estado-calculo>Confirmá las ubicaciones para calcular.</p>
        <noscript>El autocompletado y el cálculo interactivo requieren JavaScript habilitado.</noscript>
    </form>
}
@if (!Model.UsaAutocompletado && Model.Ubicaciones.Count > 0 && Model.Ruta == null)
{
    <form asp-controller="Recorridos" asp-action="Confirmar" asp-route-viajeId="@Model.ViajeId" method="post" id="confirmar-recorrido">
        <input type="hidden" name="Sesion" value="@Model.Sesion" />
        @for (var i = 0; i < Model.Ubicaciones.Count; i++)
        {
            var ubicacion = Model.Ubicaciones[i];
            <fieldset class="panel-card" data-ubicacion="@i">
                <legend>@ubicacion.Etiqueta: @ubicacion.Direccion</legend>
                @if (ubicacion.Candidatos.Count == 0)
                {
                    <p role="alert">No se encontraron candidatos. Corregí la dirección desde el viaje y volvé a buscar.</p>
                }
                @for (var j = 0; j < ubicacion.Candidatos.Count; j++)
                {
                    var candidato = ubicacion.Candidatos[j];
                    <div class="candidato-recorrido">
                        <label><input type="radio" name="Selecciones[@i].Candidato" value="@j" data-candidato="@j" required />
                            @candidato.DireccionNormalizada</label>
                        <p>Tipo: @candidato.TipoResultado · Puerta: @(candidato.TipoNumeroPuerta ?? "sin información") ·
                            Coincidencia: @(candidato.PuntajeConsulta?.ToString("0.###") ?? "sin información") (no es precisión en metros).</p>
                        <p>Posición @(candidato.PosicionEstimada ? "estimada/interpolada" : "informada") ·
                            Número de puerta @(candidato.NumeroPuertaCorregido ? "corregido por HERE" : "sin corrección informada").</p>
                        <p>Position: @candidato.Posicion.Latitud, @candidato.Posicion.Longitud</p>
                        <label>Punto para navegar (elegir explícitamente)
                            <select name="Selecciones[@i].Acceso" data-accesos="@j" disabled required>
                                <option value="">Seleccioná un punto</option>
                                <option value="-1">Usar position de referencia (no necesariamente acceso vehicular)</option>
                                @for (var k = 0; k < candidato.Accesos.Count; k++)
                                {
                                    <option value="@k">Access @(k + 1): @candidato.Accesos[k].Latitud, @candidato.Accesos[k].Longitud</option>
                                }
                            </select>
                        </label>
                    </div>
                }
            </fieldset>
        }
        <button class="panel-button" type="submit" disabled="@(Model.Ubicaciones.Any(u => u.Candidatos.Count == 0))">Confirmar ubicaciones y calcular recorrido</button>
    </form>
}
    <section class="panel-card" id="resultado-recorrido" hidden="@(Model.Ruta == null)">
        <h2>Recorrido calculado por HERE</h2>
        <div data-resumen-recorrido>
        @if (Model.Ruta != null)
        {
        <p>@((Model.Ruta.Totales.DistanciaMetros / 1000m).ToString("0.###")) km ·
            @((Model.Ruta.Totales.DuracionSegundos / 60m).ToString("0.#")) minutos estimados.</p>
        <p>Automóvil, paradas en orden, sin tráfico en tiempo real ni fecha de salida (departureTime=any).</p>
        <ol>
            @for (var i = 0; i < Model.Ubicaciones.Count; i++)
            {
                var confirmado = Model.CandidatosConfirmados[i];
                <li>@Model.Ubicaciones[i].Etiqueta: @confirmado.DireccionNormalizada
                    — position: @confirmado.Posicion.Latitud, @confirmado.Posicion.Longitud
                    — navegación confirmada (@(Model.AccesosConfirmados[i] == -1 ? "position" : $"access {Model.AccesosConfirmados[i] + 1}")):
                    @Model.PuntosConfirmados[i].Latitud, @Model.PuntosConfirmados[i].Longitud
                    (@confirmado.TipoResultado; @(confirmado.PosicionEstimada ? "estimada/interpolada" : "posición informada")).</li>
                @if (Model.UsaAutocompletado)
                {
                    <li>Identificador HERE: @confirmado.IdHere · Ubicación confirmada para esta previsualización.</li>
                }
            }
        </ol>
        }
        </div>
        <div id="mapa-recorrido" role="region" aria-label="Mapa interactivo del recorrido"
             data-teselas="@Url.Action("Tesela", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion, z = 0, x = 0, y = 0 })"
             data-atribuciones="@Url.Action("Atribuciones", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion })"></div>
        <p id="estado-mapa" role="status"></p>
        <details><summary>Avisos de los proveedores del mapa</summary><div id="avisos-mapa"></div></details>
    </section>
@if (Model.Ruta != null)
{
    <script id="datos-recorrido" type="application/json">@Html.Raw(JsonSerializer.Serialize(
        RuteaYa.Web.Models.MapaRecorridoViewModel.Crear(Model,
            Url.Action("Tesela", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion, z = 0, x = 0, y = 0 }),
            Url.Action("Atribuciones", "Recorridos", new { viajeId = Model.ViajeId, sesion = Model.Sesion })),
        new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
}
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
    <script src="~/js/here-http.js" asp-append-version="true"></script>
    <script src="~/js/recorridos.js" asp-append-version="true"></script>
    <script src="~/js/direcciones-here.js" asp-append-version="true"></script>
}
