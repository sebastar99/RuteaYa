
@model RuteaYa.Web.Models.ViajeViewModel

@{
    ViewData["Title"] = "Nuevo viaje";
    ViewData["ActivePage"] = "Viajes";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">CREAR</span>
        <h1>Nuevo viaje</h1>
        <p>Definir un recorrido habitual para encontrar viajes compatibles.</p>
    </div>

    <a class="panel-button outline" asp-action="Viajes">
        ← Volver
    </a>
</div>

<div asp-validation-summary="ModelOnly" class="panel-alert"></div>

<div class="panel-card">
    <form asp-controller="Panel" asp-action="NuevoViaje" method="post" class="panel-form">

        @Html.AntiForgeryToken()

        <div>
            <h2>Informacion principal</h2>
            <p>Completar los campos obligatorios.</p>
        </div>

        <div class="panel-form-grid">

            <div class="panel-field">
                <label asp-for="Origen">Origen *</label>
                <input asp-for="Origen" class="panel-input" placeholder="Ej: Mataderos, CABA" />
                <span asp-validation-for="Origen"></span>
            </div>

            <div class="panel-field">
                <label asp-for="Destino">Destino *</label>
                <input asp-for="Destino" class="panel-input" placeholder="Ej: Lomas de Zamora" />
                <span asp-validation-for="Destino"></span>
            </div>

            <div class="panel-field">

                <label asp-for="ParadasTexto">
                    Paradas intermedias
                </label>

                <input asp-for="ParadasTexto" class="panel-input" placeholder="Ej: Lanus, Banfield (separadas por coma)" />
                <span asp-validation-for="ParadasTexto"></span>

            </div>

            <div class="panel-field">
                <label asp-for="HoraSalida">Hora de salida *</label>
                <input asp-for="HoraSalida" class="panel-input" type="time" step="1" />
                <span asp-validation-for="HoraSalida"></span>
            </div>

            <div class="panel-field">

                <label asp-for="HoraLlegada">
                    Hora estimada de llegada *
                </label>

                <input asp-for="HoraLlegada" class="panel-input" type="time" step="1" />
                <span asp-validation-for="HoraLlegada"></span>

            </div>

            <div class="panel-field">

                <label asp-for="CantMaxPaquetes">
                    Maxima cantidad de paquetes *
                </label>

                <input asp-for="CantMaxPaquetes" class="panel-input" type="number" 
                    min="1" max="100" placeholder="3" 
                />

                <span asp-validation-for="CantMaxPaquetes"></span>

            </div>

            <div class="panel-field">
                <label asp-for="PesoMax">Peso maximo (kg) *</label>

                <input asp-for="PesoMax" class="panel-input" type="number"
                    min="0.01" step="0.01" placeholder="10"
                />

                <span asp-validation-for="PesoMax"></span>
            </div>

            <div class="panel-field">

                <label asp-for="DesvioMaxKm">
                    Desvio maximo (km) *
                </label>

                <input asp-for="DesvioMaxKm" class="panel-input" type="number"
                    min="0" step="0.01" placeholder="5" 
                />

                <span asp-validation-for="DesvioMaxKm"></span>

            </div>

            <div class="panel-field">
                <label>Dias de circulacion *</label>

                <div class="panel-checks">
                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="1" 
                            checked="@Model.DiasSemana.Contains(1)" 
                        />
                        Lun

                    </label>

                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="2"
                            checked="@Model.DiasSemana.Contains(2)" 
                        />
                        Mar

                    </label>

                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="3"
                            checked="@Model.DiasSemana.Contains(3)" 
                        />
                        Mie

                    </label>

                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="4"
                            checked="@Model.DiasSemana.Contains(4)" 
                        />
                        Jue

                    </label>

                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="5"
                            checked="@Model.DiasSemana.Contains(5)" 
                        />
                        Vie

                    </label>

                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="6"
                            checked="@Model.DiasSemana.Contains(6)" 
                        />
                        Sab

                    </label>

                    <label class="panel-check">

                        <input type="checkbox" name="DiasSemana" value="7"
                            checked="@Model.DiasSemana.Contains(7)" 
                        />
                        Dom

                    </label>
                </div>

                <span asp-validation-for="DiasSemana"></span>
            </div>

        </div>

        <div class="panel-form-actions">
            <a class="panel-button outline" asp-action="Viajes">
                Cancelar
            </a>

            <button class="panel-button" type="submit">
                Guardar viaje
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}