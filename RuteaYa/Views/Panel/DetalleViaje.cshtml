@model RuteaYa.Web.Models.ViajeViewModel

@{
    ViewData["Title"] = "Detalle del viaje";
    ViewData["ActivePage"] = "Viajes";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var dias = Model.DiasSemana ?? new List<int>();
    var paradas = Model.Paradas ?? new List<RuteaYa.Web.Models.ParadaViewModel>();

    string NombreDia(int dia) => dia switch
    {
        1 => "Lun",
        2 => "Mar",
        3 => "Mie",
        4 => "Jue",
        5 => "Vie",
        6 => "Sab",
        7 => "Dom",
        _ => dia.ToString()
    };
}

<div class="page-heading">
    <div>
        <span class="eyebrow">RUTEAYA / GESTION</span>
        <h1>Detalle del viaje</h1>
        <p>Revisa el recorrido, los horarios y la capacidad configurada.</p>
    </div>

    <a class="panel-button outline" asp-controller="Panel" asp-action="Viajes">
        ← Volver a mis viajes
    </a>
</div>

@if (ViewBag.Error is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="panel-card" role="alert">
        <strong>No se pudo cargar el viaje.</strong>
        <p>@error</p>
    </div>
}
else
{
    <div class="panel-card">

        <div>
            <span class="eyebrow">RECORRIDO</span>
            <h2>@Model.Origen → @Model.Destino</h2>

            @if (TempData["MensajeExito"] is string mensajeExito)
            {
                <div class="panel-card" role="status">
                    @mensajeExito
                </div>
            }

            @if (TempData["MensajeError"] is string mensajeError)
            {
                <div class="panel-card" role="alert">
                    @mensajeError
                </div>
            }

            <div class="panel-actions">
                @if (Model.Activo)
                {
                    <a asp-controller="Panel" asp-action="EditarViaje"
                    asp-route-id="@Model.Id" class="btn btn-primary">
                        Editar viaje
                    </a>

                    <form asp-controller="Panel" asp-action="DesactivarViaje" asp-route-id="@Model.Id"
                    method="post" onsubmit="return confirm('¿Querés desactivar este viaje?');">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">
                            Desactivar viaje
                        </button>
                    </form>
                }
            </div>

            @if (Model.Activo)
            {
                <span class="panel-pill green">Activo</span>
            }
            else
            {
                <span class="panel-pill blue">Inactivo</span>
            }
        </div>

        <div class="panel-stats">

            <div class="panel-stat">
                <span>Hora de salida</span>
                <strong>
                    @Model.HoraSalida.ToString(@"hh\:mm")
                </strong>
            </div>

            <div class="panel-stat">
                <span>Hora de llegada</span>
                <strong>
                    @Model.HoraLlegada.ToString(@"hh\:mm")
                </strong>
            </div>

            <div class="panel-stat">
                <span>Máximo de paquetes</span>
                <strong>@Model.CantMaxPaquetes</strong>
            </div>

        </div>

        <div class="panel-form-grid">

            <div class="panel-field">
                <label>Dias de circulacion</label>
                <p>
                    @if (dias.Count > 0)
                    {
                        @string.Join(", ", dias.Select(NombreDia))
                    }
                    else
                    {
                        <span>No hay dias registrados.</span>
                    }
                </p>
            </div>

            <div class="panel-field">
                <label>Peso maximo</label>
                <p>@Model.PesoMax kg</p>
            </div>

            <div class="panel-field">
                <label>Desvio maximo</label>
                <p>@Model.DesvioMaxKm km</p>
            </div>

            <div class="panel-field">
                <label>Estado</label>
                <p>@(Model.Activo ? "Activo" : "Inactivo")</p>
            </div>

        </div>

    </div>

    <div class="panel-card">
        <h2>Paradas intermedias</h2>

        @if (Model.Activo)
        {
            <form asp-controller="Panel" asp-action="AgregarParada" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="viajeId" value="@Model.Id" />

                <div class="panel-form-grid">

                    <div>
                        <label for="ubicacion">Ubicacion de la parada</label>

                        <input type="text" id="ubicacion" name="ubicacion"  maxlength="150"
                            required class="panel-input" placeholder="Ej. Chivilcoy, Buenos Aires" 
                        />
                    </div>

                    <div>
                        <label for="orden">Orden de la parada</label>

                        <input type="number" id="orden" name="orden" min="1" max="100"
                            value="@(paradas.Count + 1)" required class="panel-input" 
                        />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Agregar parada
                </button>
            </form>

            <hr />
        }

        @if (paradas.Count == 0)
        {
            <p>Este viaje todavia no tiene paradas intermedias.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">

                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Ubicación</th>

                            @if (Model.Activo)
                            {
                                <th>Acciones</th>
                            }
                            
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var parada in paradas.OrderBy(p => p.Orden))
                        {
                            <tr>
                                <td>@parada.Orden</td>
                                <td>@parada.Ubicacion</td>

                                @if (Model.Activo)
                                {
                                    <td>
                                        <form asp-controller="Panel" asp-action="EliminarParada" method="post"
                                        onsubmit="return confirm('¿Querés eliminar esta parada?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="viajeId" value="@Model.Id" />
                                            <input type="hidden" name="paradaId" value="@parada.Id" />

                                            <button type="submit" class="btn btn-danger">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    
                </table>
            </div>
        }
    </div>
}