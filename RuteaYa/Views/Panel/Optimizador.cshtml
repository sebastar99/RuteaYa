@{ ViewData["Title"]="Optimizador"; ViewData["ActivePage"]="Optimizador"; Layout="~/Views/Shared/_PanelLayout.cshtml"; }
<div class="page-heading"><div><span class="eyebrow">PLANIFICACIÓN INTELIGENTE</span><h1>Optimizador de oportunidades</h1><p>Compará paquetes por ganancia, peso y desvío permitido.</p></div><button class="panel-button outline" onclick="alert('El cálculo se conectará con la lógica de negocio.')">↻ Recalcular</button></div>
<div class="panel-card"><h2>Viaje de referencia</h2><div class="panel-route-line"><span class="panel-point"></span><strong>Belgrano</strong><div class="panel-line"></div><span class="panel-point end"></span><strong>Lomas de Zamora</strong></div></div>
<div class="panel-stats"><div class="panel-stat"><span>Paquetes máximos</span><strong>3</strong></div><div class="panel-stat"><span>Peso máximo</span><strong>10 kg</strong></div><div class="panel-stat"><span>Desvío máximo</span><strong>5 km</strong></div><div class="panel-stat highlight"><span>Ganancia estimada</span><strong>$4.000</strong></div></div>
<div class="panel-card"><h2>Combinación recomendada</h2><div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Envío</th><th>Peso</th><th>Desvío</th><th>Pago</th></tr></thead><tbody><tr><td><strong>Caballito → Lomas de Zamora</strong><span class="panel-muted">Zapatillas</span></td><td>2 kg</td><td>1 km</td><td><strong>$4.000</strong></td></tr></tbody></table></div><div class="panel-form-actions"><a class="panel-button" asp-action="ConfirmarCombinacion">Revisar combinación →</a></div></div>
<div class="panel-card"><h2>Capacidad utilizada</h2><p>Paquetes</p><div class="panel-progress"><span style="width:33%"></span></div><p style="margin-top:14px">Peso</p><div class="panel-progress"><span style="width:20%"></span></div><p style="margin-top:14px">Desvío</p><div class="panel-progress"><span style="width:20%"></span></div></div>