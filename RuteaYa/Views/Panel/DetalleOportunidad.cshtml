@model RuteaYa.Web.Models.DetalleOportunidadViewModel
@using RuteaYa.Logica.DTOs
@using RuteaYa.Web.Models
@{
    ViewData["Title"] = "Detalle de oportunidad";
    ViewData["ActivePage"] = "Oportunidades";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">DETALLE DEL ENVÍO</span>
        <h1>Detalle de oportunidad</h1>
        <p>Revisá si el envío entra en tu viaje y aceptalo.</p>
    </div>
    <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index"
       asp-route-viajeId="@Model.ViajeId" asp-route-pagina="@Model.Pagina"
       asp-route-salidaId="@Model.Detalle?.Viaje.SalidaSeleccionada?.Id"
       asp-route-tamanoPagina="@Model.TamanoPagina">Volver al listado</a>
</div>

@if (TempData["ErrorAceptacion"] is string errorAceptacion) { <div class="panel-alert danger" role="alert">@errorAceptacion</div> }

@if (Model.Error != null)
{
    <div class="panel-card" role="alert"><p>@Model.Error</p></div>
}
else if (Model.Detalle != null)
{
    var candidato = Model.Detalle;
    var envio = candidato.Envio;
    var evaluacion = candidato.Evaluacion;
    var estado = PresentacionOportunidad.Estado(evaluacion);
    var color = PresentacionOportunidad.Color(estado);
    var adicional = PresentacionOportunidad.Adicional(evaluacion);
    var salidaElegida = candidato.Viaje.SalidaSeleccionada;
    var noAcepta = PresentacionOportunidad.NoSePuedeAceptar(candidato);
    <div class="panel-card">
        <div class="detail-head">
            <h2>@candidato.Viaje.Origen → @candidato.Viaje.Destino</h2>
            <a class="panel-button outline small" asp-controller="Recorridos" asp-action="Index"
               asp-route-viajeId="@candidato.Viaje.Id">Ver recorrido en el mapa</a>
        </div>
        @if (salidaElegida is { } salida) { <partial name="_SalidaOportunidad" model="salida" /> }
        else { <p>Todavía no elegiste la fecha de salida de este viaje.</p> }
    </div>

    <div class="panel-card">
        <div class="opp-card-head">
            <h2>@envio.Descripcion</h2>
            <span class="opp-reward">@envio.Monto.ToString("C")</span>
        </div>
        <div class="opp-route">
            <div><small>Retiro</small>@envio.OrigenDir</div>
            <div><small>Entrega</small>@envio.DestinoDir</div>
        </div>
        <dl class="opp-meta" style="margin-top:14px">
            <div><dt>Peso</dt><dd>@envio.PesoKg.ToString("0.##") kg</dd></div>
            <div><dt>Tamaño</dt><dd>@envio.TamanoTexto</dd></div>
            <div><dt>Fecha límite</dt><dd>@(envio.FechaLimite == default ? "Sin dato" : envio.FechaLimite.TimeOfDay == TimeSpan.Zero ? envio.FechaLimite.ToString("dd/MM/yyyy") : envio.FechaLimite.ToString("dd/MM/yyyy HH:mm"))</dd></div>
        </dl>
    </div>

    <div class="panel-card">
        <div class="detail-head">
            <h2>Compatibilidad con tu viaje</h2>
            <span class="panel-pill @color">@PresentacionOportunidad.Etiqueta(estado)</span>
        </div>
        @if (adicional.HasValue)
        {
            <p>Para llevarlo, tu recorrido cambia aproximadamente <strong>@PresentacionOportunidad.Firmado(adicional.Value.Km, "0.#") km</strong> y <strong>@PresentacionOportunidad.Firmado(adicional.Value.Minutos, "0") minutos</strong>.</p>
        }
        <ul class="cond-list">
            @foreach (var condicion in PresentacionOportunidad.Condiciones(candidato))
            {
                var colorCondicion = condicion.Resultado switch { ResultadoCondicion.Cumple => "green", ResultadoCondicion.NoCumple => "red", _ => "orange" };
                var icono = condicion.Resultado switch { ResultadoCondicion.Cumple => "✓", ResultadoCondicion.NoCumple => "✕", _ => "!" };
                <li class="cond-item">
                    <span class="cond-icon @colorCondicion" aria-hidden="true">@icono</span>
                    <div>
                        <strong>@condicion.Nombre</strong>
                        <span class="cond-detalle">@condicion.Detalle</span>
                    </div>
                </li>
            }
        </ul>
    </div>

    <div class="panel-card accept-box">
        @if (noAcepta == null && salidaElegida != null)
        {
            <form method="post" asp-controller="Oportunidades" asp-action="Aceptar">
                <input type="hidden" name="viajeId" value="@candidato.Viaje.Id" />
                <input type="hidden" name="salidaId" value="@salidaElegida.Id" />
                <input type="hidden" name="envioId" value="@envio.Id" />
                <button class="panel-button" type="submit">Aceptar envío</button>
            </form>
            <p class="accept-solucion">Al aceptar, el envío pasa a Mis transportes y se descuenta de la capacidad de tu salida.</p>
        }
        else
        {
            <button class="panel-button" type="button" disabled aria-disabled="true">Aceptar envío</button>
            <p class="accept-motivo" role="status">@noAcepta?.Motivo</p>
            @if (noAcepta?.Solucion != null) { <p class="accept-solucion">@noAcepta.Solucion</p> }
        }
    </div>
}
