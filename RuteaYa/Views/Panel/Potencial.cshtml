@model RuteaYa.Web.Models.PotencialViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Potencial de ganancias";
    ViewData["ActivePage"] = "Oportunidades";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var cultura = CultureInfo.GetCultureInfo("es-AR");
    var weeks = Model.MontosSemanales;
    var max = Math.Max(weeks.DefaultIfEmpty(0).Max(), 1m);
}
<div class="page-heading"><div><span class="eyebrow">ANÁLISIS DE INGRESOS</span><h1>Potencial de ganancias</h1><p>Estimación de ingresos posibles con los envíos que buscan conductor.</p></div><span class="panel-pill blue">@DateTime.Now.ToString("MMMM yyyy", cultura)</span></div>
<div class="panel-alert">El potencial no es una ganancia garantizada. Suma los montos de los envíos de otros usuarios que siguen buscando conductor, sin verificar la compatibilidad de ruta.</div>
<div class="panel-stats">
    <div class="panel-stat highlight"><span>Potencial total</span><strong>@Model.PotencialTotal.ToString("C0", cultura)</strong></div>
    <div class="panel-stat"><span>Envíos candidatos</span><strong>@Model.EnviosCandidatos</strong></div>
    <div class="panel-stat"><span>Viajes analizados</span><strong>@Model.ViajesAnalizados</strong></div>
    <div class="panel-stat"><span>Paquetes posibles</span><strong>@Model.PaquetesPosibles</strong></div>
</div>
<div class="panel-card">
    <h2>Estimación semanal</h2>
    <div class="panel-week-bars">
        @for (var i = 0; i < weeks.Count; i++)
        {
            <div class="panel-week"><strong>@weeks[i].ToString("C0", cultura)</strong><div class="bar" style="height:@((int)(weeks[i] * 130 / max))px"></div><small>Semana @(i + 1)</small></div>
        }
    </div>
</div>
<div class="panel-card">
    <h2>Envío con mayor potencial</h2>
    @if (Model.MejorEnvio is null)
    {
        <p class="panel-muted">No hay envíos disponibles para estimar. Necesitás al menos un viaje activo y envíos buscando conductor.</p>
    }
    else
    {
        <div class="panel-route-line"><span class="panel-point"></span><div><strong>@Model.MejorEnvio.Origen</strong><span class="panel-muted">Origen</span></div><div class="panel-line"></div><span class="panel-point end"></span><div><strong>@Model.MejorEnvio.Destino</strong><span class="panel-muted">@Model.MejorEnvio.Descripcion</span></div><strong style="color:#15805d">@Model.MejorEnvio.Importe.ToString("C0", cultura)</strong></div>
    }
</div>
