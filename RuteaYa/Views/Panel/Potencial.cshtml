@{ ViewData["Title"]="Potencial de ganancias"; ViewData["ActivePage"]="Oportunidades"; Layout="~/Views/Shared/_PanelLayout.cshtml"; var weeks=new[]{18000,24500,21000,21000}; var max=weeks.Max(); }
<div class="page-heading"><div><span class="eyebrow">ANÁLISIS DE INGRESOS</span><h1>Potencial de ganancias</h1><p>Estimación ilustrativa de ingresos posibles con tus recorridos.</p></div><span class="panel-pill blue">Octubre 2026</span></div>
<div class="panel-alert">El potencial no es una ganancia garantizada. Los valores son datos de demostración.</div>
<div class="panel-card"><div class="panel-toolbar"><div><h2>Criterio de estimación</h2><p>Elegí el enfoque que querés analizar.</p></div><select class="panel-select" style="max-width:260px"><option>Maximizar ganancias</option><option>Minimizar desvíos</option><option>Equilibrio</option></select></div></div>
<div class="panel-stats"><div class="panel-stat highlight"><span>Potencial mensual</span><strong>$84.500</strong></div><div class="panel-stat"><span>Ganancia efectiva</span><strong>$21.000</strong></div><div class="panel-stat"><span>Viajes analizados</span><strong>12</strong></div><div class="panel-stat"><span>Paquetes posibles</span><strong>27</strong></div></div>
<div class="panel-card"><h2>Estimación semanal</h2><div class="panel-week-bars">@for(var i=0;i<weeks.Length;i++){<div class="panel-week"><strong>@weeks[i].ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong><div class="bar" style="height:@(weeks[i]*130/max)px"></div><small>Semana @(i+1)</small></div>}</div></div>
<div class="panel-card"><h2>Recorrido con mayor potencial</h2><div class="panel-route-line"><span class="panel-point"></span><div><strong>Belgrano</strong><span class="panel-muted">Lun, Mié, Vie</span></div><div class="panel-line"></div><span class="panel-point end"></span><div><strong>Lomas de Zamora</strong><span class="panel-muted">Destino habitual</span></div><strong style="color:#15805d">$40.560</strong></div></div>