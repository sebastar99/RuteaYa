@{ ViewData["Title"]="Nuevo envío"; ViewData["ActivePage"]="Envios"; Layout="~/Views/Shared/_PanelLayout.cshtml"; }
<div class="page-heading"><div><span class="eyebrow">CREACIÓN</span><h1>Nuevo envío</h1><p>Publicá un paquete que necesita ser transportado.</p></div><a class="panel-button outline" href="/Panel/Envios">← Volver</a></div>
<div class="panel-alert">Formulario de interfaz. El guardado todavía no está conectado con la API ni con SQL Server.</div>
<div class="panel-card"><form class="panel-form" onsubmit="event.preventDefault();alert('La pantalla está lista visualmente. Falta conectar el formulario con la API.');"><div><h2>Información principal</h2><p>Completá los campos obligatorios.</p></div><div class="panel-form-grid"><div class="panel-field"><label for="origen">Origen / dirección de retiro *</label><input class="panel-input" id="origen" name="origen" type="text" placeholder="Calle, número, localidad" required /></div><div class="panel-field"><label for="destino">Destino / dirección de entrega *</label><input class="panel-input" id="destino" name="destino" type="text" placeholder="Calle, número, localidad" required /></div><div class="panel-field"><label for="fecha">Fecha límite *</label><input class="panel-input" id="fecha" name="fecha" type="date" placeholder="" required /></div><div class="panel-field"><label for="descripcion">Descripción del paquete *</label><input class="panel-input" id="descripcion" name="descripcion" type="text" placeholder="Ej. Documentación, repuesto" required /></div><div class="panel-field"><label for="peso">Peso estimado (kg) *</label><input class="panel-input" id="peso" name="peso" type="number" placeholder="Ej. 2.5" required /></div><div class="panel-field"><label for="monto">Monto ofrecido ($) *</label><input class="panel-input" id="monto" name="monto" type="number" placeholder="Ej. 4000" required /></div><div class="panel-field"><label for="tamano">Tamaño *</label><select id="tamano" class="panel-select" required><option value="">Seleccioná un tamaño</option><option>Pequeño</option><option>Mediano</option><option>Grande</option></select></div><div class="panel-field"><label for="referencia">Indicaciones adicionales</label><textarea class="panel-textarea" id="referencia" placeholder="Piso, horario, referencia..."></textarea></div></div><div class="panel-form-actions"><a class="panel-button outline" href="/Panel/Envios">Cancelar</a><button class="panel-button" type="submit">Publicar envío</button></div></form></div>