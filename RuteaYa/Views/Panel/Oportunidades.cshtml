@model RuteaYa.Web.Models.OportunidadesViewModel
@using RuteaYa.Logica.DTOs
@using RuteaYa.Web.Models
@{
    ViewData["Title"] = "Oportunidades";
    ViewData["ActivePage"] = "Oportunidades";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var listado = Model.Listado;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">RUTEAYA / GESTIÓN</span>
        <h1>Candidatos para tu viaje</h1>
        <p>Elegí tu viaje y la fecha de salida para ver qué envíos entran en tu recorrido.</p>
    </div>
    <div class="panel-actions">
        @if (listado.ViajeSeleccionado?.SalidaSeleccionada != null)
        { <a class="panel-button" asp-controller="Optimizador" asp-action="Resultado" asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada.Id">Optimizar oportunidades</a> }
        else if (listado.ViajeSeleccionado != null)
        { <a class="panel-button" asp-controller="Optimizador" asp-action="Index" asp-route-viajeId="@listado.ViajeSeleccionado.Id">Optimizar oportunidades</a> }
        else { <a class="panel-button" asp-controller="Optimizador" asp-action="Index">Optimizar oportunidades</a> }
        <a class="panel-button outline" asp-controller="Panel" asp-action="Viajes">Mis viajes</a>
    </div>
</div>

@if (TempData["ErrorAceptacion"] is string errorAceptacion) { <div class="panel-alert danger" role="alert">@errorAceptacion</div> }

@if (Model.Error != null)
{
    <div class="panel-card" role="alert">
        <p>@Model.Error</p>
        <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index">Volver a intentar</a>
    </div>
}
else if (listado.Viajes.Count == 0 && ViewData.ModelState.IsValid)
{
    <div class="panel-card">
        <h2>No tenés viajes registrados</h2>
        <p>Creá un viaje para ver los envíos que podés llevar.</p>
        <a class="panel-button" asp-controller="Panel" asp-action="NuevoViaje">Crear viaje</a>
    </div>
}
else
{
    <div class="panel-card">
        <form method="get" asp-controller="Oportunidades" asp-action="Index" class="panel-form">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            @Html.ValidationMessage("pagina")
            <div class="panel-form-grid">
                <div class="panel-field">
                    <label for="viajeId">Tu viaje</label>
                    <select id="viajeId" name="viajeId" class="panel-select" required>
                        <option value="">Elegí un viaje</option>
                        @foreach (var viaje in listado.Viajes)
                        {
                            <option value="@viaje.Id" selected="@(viaje.Id == listado.ViajeSeleccionado?.Id || ViewData.ModelState["viajeId"]?.AttemptedValue == viaje.Id.ToString())">
                                @viaje.Origen → @viaje.Destino @(viaje.Activo ? "" : "(inactivo)")
                            </option>
                        }
                    </select>
                    @Html.ValidationMessage("viajeId")
                </div>
                <div class="panel-field">
                    <label for="tamanoPagina">Envíos por página (1 a 50)</label>
                    <input id="tamanoPagina" name="tamanoPagina" class="panel-input" type="number"
                           min="1" max="50" value="@listado.TamanoPagina" required />
                    @Html.ValidationMessage("tamanoPagina")
                </div>
            </div>
            <div class="panel-form-actions"><button type="submit" class="panel-button">Ver envíos</button></div>
        </form>
    </div>

    @if (listado.ViajeSeleccionado == null)
    {
        <div class="panel-card"><p>Elegí un viaje para ver los envíos disponibles.</p></div>
    }
    else
    {
        @if (TempData["ErrorSalida"] is string errorSalida) { <div class="panel-alert" role="alert">@errorSalida</div> }
        <div class="panel-card">
            <h2>¿Cuándo vas a realizar el viaje?</h2>
            <p>Salís a las @Model.HoraSalida.ToString(@"hh\:mm"). Elegí una fecha de tus días de viaje:
                @string.Join(", ", Model.DiasHabilitados.OrderBy(d => d).Select(d => new[] { "", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo" }[d])).</p>
            <form method="post" asp-controller="Oportunidades" asp-action="SeleccionarSalida" class="panel-form" data-form-salida>
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <input type="hidden" name="ViajeId" value="@listado.ViajeSeleccionado.Id" />
                <div class="panel-form-grid">
                    <div class="panel-field"><label for="Fecha">Fecha de salida</label><input asp-for="Seleccion.Fecha" class="panel-input" type="date" id="Fecha" name="Fecha" data-dias="@string.Join(",", Model.DiasHabilitados)" required />@Html.ValidationMessage("Fecha")<span data-error-fecha role="status"></span></div>
                    @if (Model.ZonaAutomatica != null) { <p class="panel-help">Los horarios se toman en hora de Argentina.</p> }
                    else {
                        <div class="panel-field"><label for="ZonaHorariaId">¿En qué zona horaria comienza el viaje?</label>
                            <select asp-for="Seleccion.ZonaHorariaId" class="panel-select" name="ZonaHorariaId" id="ZonaHorariaId"><option value="">Elegí la zona del horario de salida</option>
                                @foreach (var zona in TimeZoneInfo.GetSystemTimeZones()) { <option value="@zona.Id">@zona.DisplayName</option> }
                            </select>
                            @Html.ValidationMessage("ZonaHorariaId")
                        </div>
                    }
                    <div class="panel-field"><label for="tipo-limite">Horario de llegada</label><select asp-for="Seleccion.LlegadaSinRestriccion" class="panel-select" id="tipo-limite" name="LlegadaSinRestriccion" data-tipo-limite><option value="true">Sin horario límite</option><option value="false">Establecer horario límite</option></select>@Html.ValidationMessage("LlegadaSinRestriccion")</div>
                    <div class="panel-field" data-campo-limite hidden="@Model.Seleccion.LlegadaSinRestriccion"><label for="LlegadaMaximaLocal">Llegar como máximo el (hora del lugar de salida)</label><input asp-for="Seleccion.LlegadaMaximaLocal" class="panel-input" type="datetime-local" id="LlegadaMaximaLocal" name="LlegadaMaximaLocal" disabled="@Model.Seleccion.LlegadaSinRestriccion" required="@(!Model.Seleccion.LlegadaSinRestriccion)" />@Html.ValidationMessage("LlegadaMaximaLocal")</div>
                </div>
                <button class="panel-button" type="submit">Elegir salida y evaluar</button>
            </form>
            @if (listado.ViajeSeleccionado.SalidaSeleccionada is { } salida)
            {
                <hr class="panel-divider" />
                <partial name="_SalidaOportunidad" model="salida" />
            }
        </div>

        <div class="panel-card">
            <div class="detail-head">
                <div>
                    <h2>@listado.ViajeSeleccionado.Origen → @listado.ViajeSeleccionado.Destino</h2>
                    <p>@(listado.TotalCandidatos == 1 ? "1 envío busca conductor." : $"{listado.TotalCandidatos} envíos buscan conductor.")
                        @if (!listado.ViajeSeleccionado.Activo) { <text> Tu viaje está inactivo.</text> }</p>
                </div>
                <a class="panel-button outline small" asp-controller="Recorridos" asp-action="Index"
                   asp-route-viajeId="@listado.ViajeSeleccionado.Id">Ver recorrido en el mapa</a>
            </div>
        </div>

        @if (listado.Candidatos.Count == 0)
        {
            <div class="panel-card"><h2>No hay envíos disponibles</h2><p>Cuando otros usuarios publiquen envíos, vas a verlos acá.</p></div>
        }
        else
        {
            <div class="opp-grid">
                @foreach (var envio in listado.Candidatos)
                {
                    listado.Evaluaciones.TryGetValue(envio.Id, out var evaluacion);
                    var estado = PresentacionOportunidad.Estado(evaluacion);
                    var color = PresentacionOportunidad.Color(estado);
                    var adicional = PresentacionOportunidad.Adicional(evaluacion);
                    <article class="opp-card @color">
                        <div class="opp-card-head">
                            <h3>@envio.Descripcion</h3>
                            <span class="opp-reward">@envio.Monto.ToString("C")</span>
                        </div>
                        <div class="opp-route">
                            <div><small>Retiro</small>@envio.OrigenDir</div>
                            <div><small>Entrega</small>@envio.DestinoDir</div>
                        </div>
                        <dl class="opp-meta">
                            <div><dt>Peso</dt><dd>@envio.PesoKg.ToString("0.##") kg · @envio.TamanoTexto</dd></div>
                            <div><dt>Fecha límite</dt><dd>@(envio.FechaLimite == default ? "Sin dato" : envio.FechaLimite.TimeOfDay == TimeSpan.Zero ? envio.FechaLimite.ToString("dd/MM/yyyy") : envio.FechaLimite.ToString("dd/MM/yyyy HH:mm"))</dd></div>
                            @if (adicional.HasValue)
                            {
                                <div><dt>Desvío</dt><dd>@PresentacionOportunidad.Firmado(adicional.Value.Km, "0.#") km · @PresentacionOportunidad.Firmado(adicional.Value.Minutos, "0") min</dd></div>
                            }
                        </dl>
                        <div class="opp-estado">
                            <span class="panel-pill @color">@PresentacionOportunidad.Etiqueta(estado)</span>
                            <p class="opp-msg">@PresentacionOportunidad.Resumen(evaluacion)</p>
                        </div>
                        <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Detalle"
                           asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-envioId="@envio.Id"
                           asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada?.Id"
                           asp-route-pagina="@listado.Pagina" asp-route-tamanoPagina="@listado.TamanoPagina">Ver detalle</a>
                    </article>
                }
            </div>
            <nav class="panel-form-actions" aria-label="Páginas de candidatos">
                @if (listado.Pagina > 1)
                {
                    <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index"
                       asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-pagina="@(listado.Pagina - 1)"
                       asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada?.Id"
                       asp-route-tamanoPagina="@listado.TamanoPagina">Anterior</a>
                }
                <span>Página @listado.Pagina de @listado.TotalPaginas</span>
                @if (listado.Pagina < listado.TotalPaginas)
                {
                    <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index"
                       asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-pagina="@(listado.Pagina + 1)"
                       asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada?.Id"
                       asp-route-tamanoPagina="@listado.TamanoPagina">Siguiente</a>
                }
            </nav>
        }
    }
}
@section Scripts { <script src="~/js/salida-viaje.js" asp-append-version="true"></script> }
