@model RuteaYa.Web.Models.OportunidadesViewModel
@using RuteaYa.Logica.DTOs
@using RuteaYa.Web.Models
@{
    ViewData["Title"] = "Oportunidades";
    ViewData["ActivePage"] = "Oportunidades";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    var listado = Model.Listado;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">RUTEAYA / GESTIÓN</span>
        <h1>Candidatos para tu viaje</h1>
        <p>Evaluación de publicaciones disponibles con datos confirmados del servidor.</p>
    </div>
    <a class="panel-button outline" asp-controller="Panel" asp-action="Viajes">Mis viajes</a>
</div>

<div class="panel-alert" role="note">
    La evaluación distingue condiciones verificadas y datos pendientes. Un desvío aprobado
    por sí solo no confirma salida, capacidad ni horarios. Las rutas son estimaciones de HERE.
    La aceptación está deshabilitada hasta validar compatibilidad, capacidad y asignación al viaje concreto.
</div>

@if (Model.Error != null)
{
    <div class="panel-card" role="alert">
        <p>@Model.Error</p>
        <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index">Volver a intentar</a>
    </div>
}
else if (listado.Viajes.Count == 0)
{
    <div class="panel-card"><h2>No tenés viajes registrados</h2><p>Consultá tus viajes para comenzar.</p></div>
}
else
{
    <div class="panel-card">
        <form method="get" asp-controller="Oportunidades" asp-action="Index" class="panel-form">
            <div class="panel-form-grid">
                <div class="panel-field">
                    <label for="viajeId">Seleccioná uno de tus viajes</label>
                    <select id="viajeId" name="viajeId" class="panel-select" required>
                        <option value="">Elegí un viaje</option>
                        @foreach (var viaje in listado.Viajes)
                        {
                            <option value="@viaje.Id" selected="@(viaje.Id == listado.ViajeSeleccionado?.Id)">
                                @viaje.Origen → @viaje.Destino @(viaje.Activo ? "" : "(inactivo)")
                            </option>
                        }
                    </select>
                </div>
                <div class="panel-field">
                    <label for="tamanoPagina">Envíos por página (1 a 50)</label>
                    <input id="tamanoPagina" name="tamanoPagina" class="panel-input" type="number"
                           min="1" max="50" value="@listado.TamanoPagina" required />
                </div>
            </div>
            <div class="panel-form-actions"><button type="submit" class="panel-button">Consultar candidatos</button></div>
        </form>
    </div>

    @if (listado.ViajeSeleccionado == null)
    {
        <div class="panel-card"><p>Elegí un viaje para consultar envíos publicados. Aún no se consultaron candidatos.</p></div>
    }
    else
    {
        @if (TempData["ErrorSalida"] is string errorSalida) { <div class="panel-alert" role="alert">@errorSalida</div> }
        <div class="panel-card">
            <h2>Salida concreta</h2>
            <p>La hora de salida es la publicada en tu viaje. Elegí una fecha de sus días habilitados.
                Si ya existe, se selecciona la salida guardada sin modificar sus horarios.</p>
            <form method="post" asp-controller="Oportunidades" asp-action="SeleccionarSalida" class="panel-form">
                <input type="hidden" name="ViajeId" value="@listado.ViajeSeleccionado.Id" />
                <div class="panel-form-grid">
                    <div class="panel-field"><label for="Fecha">Fecha de salida</label><input class="panel-input" type="date" id="Fecha" name="Fecha" required /></div>
                    <div class="panel-field"><label for="OffsetUtcMinutos">Offset UTC en minutos (para una salida nueva)</label><input class="panel-input" type="number" id="OffsetUtcMinutos" name="OffsetUtcMinutos" min="-840" max="840" step="1" /><small>Ingresalo explícitamente: UTC−03:00 = −180; UTC = 0. No se usa la zona del servidor.</small></div>
                    <div class="panel-field"><label for="LlegadaMaximaLocal">Llegada máxima local (opcional, mismo offset)</label><input class="panel-input" type="datetime-local" id="LlegadaMaximaLocal" name="LlegadaMaximaLocal" /></div>
                    <div class="panel-field"><label><input type="checkbox" name="LlegadaSinRestriccion" value="true" /> No tengo un límite máximo de llegada</label><small>Si no informás un límite ni marcás esta opción, queda desconocido.</small></div>
                </div>
                <button class="panel-button" type="submit">Seleccionar salida y evaluar</button>
            </form>
            @if (listado.ViajeSeleccionado.SalidaSeleccionada is { } salida)
            {
                <partial name="_SalidaOportunidad" model="salida" />
            }
        </div>
        <div class="panel-card">
            <h2>@listado.ViajeSeleccionado.Origen → @listado.ViajeSeleccionado.Destino</h2>
            <a class="panel-button outline" asp-controller="Recorridos" asp-action="Index"
               asp-route-viajeId="@listado.ViajeSeleccionado.Id">Previsualizar recorrido del viaje</a>
            <p>Estado del viaje: @(listado.ViajeSeleccionado.Activo ? "Activo" : "Inactivo").
                Este estado no confirma la disponibilidad de una salida concreta.</p>
            <p>Envíos en búsqueda de conductor: <strong>@listado.TotalCandidatos</strong>.</p>
        </div>

        @if (listado.Candidatos.Count == 0)
        {
            <div class="panel-card"><h2>No hay envíos candidatos</h2><p>No se encontraron envíos publicados en búsqueda de conductor para mostrar.</p></div>
        }
        else
        {
            <div class="panel-card">
                <div class="panel-table-wrap">
                    <table class="panel-table">
                        <thead><tr><th>Envío</th><th>Paquete</th><th>Fecha límite publicada</th><th>Monto ofrecido</th><th>Evaluación</th><th>Detalle</th></tr></thead>
                        <tbody>
                        @foreach (var envio in listado.Candidatos)
                        {
                            <tr>
                                <td><strong>@envio.OrigenDir → @envio.DestinoDir</strong><p>@envio.Descripcion</p><small>Envío #@envio.Id</small></td>
                                <td>@envio.PesoKg.ToString("0.##") kg · @envio.TamanoTexto</td>
                                <td>@(envio.FechaLimite == default ? "No informada" : envio.FechaLimite.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>@envio.Monto.ToString("C")</td>
                                <td>
                                    @if (listado.Evaluaciones.TryGetValue(envio.Id, out var evaluacion))
                                    {
                                        var color = evaluacion.Estado == EstadoCompatibilidad.Incompatible ? "red" : evaluacion.Estado == EstadoCompatibilidad.Compatible ? "green" : "orange";
                                        <span class="panel-pill @color">@(evaluacion.Estado == EstadoCompatibilidad.Indeterminado ? "Indeterminado" : evaluacion.Estado == EstadoCompatibilidad.Compatible ? "Compatible según evaluación" : "No compatible")</span>
                                        @if (evaluacion.ResultadoMotor?.InsercionSeleccionada != null) {
                                            var desvio = evaluacion.ResultadoMotor.InsercionSeleccionada.Desvio;
                                            <p>Adicional: @((desvio.DistanciaAdicionalMetros / 1000m).ToString("0.###")) km · @((desvio.TiempoAdicionalSegundos / 60m).ToString("0.#")) min.</p>
                                        }
                                        <ul>
                                            @foreach (var motivo in evaluacion.ResultadoMotor?.Motivos ?? Array.Empty<MotivoCompatibilidad>()) { <li>@MensajesEvaluacionOportunidad.Motivo(motivo)</li> }
                                            @foreach (var pendiente in evaluacion.DatosPendientes) { <li>@MensajesEvaluacionOportunidad.DatoPendiente(pendiente)</li> }
                                        </ul>
                                    }
                                    else { <span class="panel-pill orange">Pendiente de evaluación</span> }
                                </td>
                                <td>
                                    <a class="panel-button outline small" asp-controller="Oportunidades" asp-action="Detalle"
                                       asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-envioId="@envio.Id"
                                       asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada?.Id"
                                       asp-route-pagina="@listado.Pagina" asp-route-tamanoPagina="@listado.TamanoPagina">Ver detalle</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="panel-note">Las fechas legadas sin offset siguen sin interpretación temporal; los horarios explícitos se evalúan en el motor.
                    Solo se listan envíos de otros usuarios que siguen buscando conductor; la selección de candidatos no confirma compatibilidad.</p>
                <nav class="panel-form-actions" aria-label="Páginas de candidatos">
                    @if (listado.Pagina > 1)
                    {
                        <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index"
                           asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-pagina="@(listado.Pagina - 1)"
                           asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada?.Id"
                           asp-route-tamanoPagina="@listado.TamanoPagina">Anterior</a>
                    }
                    <span>Página @listado.Pagina de @listado.TotalPaginas</span>
                    @if (listado.Pagina < listado.TotalPaginas)
                    {
                        <a class="panel-button outline" asp-controller="Oportunidades" asp-action="Index"
                           asp-route-viajeId="@listado.ViajeSeleccionado.Id" asp-route-pagina="@(listado.Pagina + 1)"
                           asp-route-salidaId="@listado.ViajeSeleccionado.SalidaSeleccionada?.Id"
                           asp-route-tamanoPagina="@listado.TamanoPagina">Siguiente</a>
                    }
                </nav>
            </div>
        }
    }
}
